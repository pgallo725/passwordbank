<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build configuration -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Platforms>x64;x86;ARM64</Platforms>
	<RuntimeIdentifiers>win-x86;win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>True</PublishTrimmed>
    <PublishAot>True</PublishAot>
    <IsAotCompatible>True</IsAotCompatible>
    <InvariantGlobalization>True</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <IntermediateOutputPath>..\obj\</IntermediateOutputPath>
    <StartupObject>PasswordBank.Program</StartupObject>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <SignAssembly>False</SignAssembly>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <!-- Application / Package metadata -->
  <PropertyGroup>
    <Authors>JackaL</Authors>
    <Title>PasswordBank</Title>
    <Version>1.1.1</Version>
    <Description>A console-based offline password manager application.</Description>
    <ApplicationIcon>passwordbank.ico</ApplicationIcon>
    <PackageIcon>passwordbank.png</PackageIcon>
    <PackageProjectUrl>https://github.com/pgallo725/passwordbank</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/pgallo725/passwordbank</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>Full</DebugType>
    <DebugSymbols>True</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>False</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\media\passwordbank.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
	<None Include="..\media\passwordbank.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
	<PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
